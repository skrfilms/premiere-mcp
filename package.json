{
  "name": "premiere-mcp",
  "version": "1.4.0",
  "description": "Premiere MCP — an MCP bridge for Adobe Premiere Pro with 649 tools for AI-driven video editing. By Skry. Based on Adobe_Premiere_Pro_MCP (MIT).",
  "main": "dist/index.js",
  "bin": {
    "premiere-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "cep-plugin",
    "uxp-plugin",
    "uxp-probe",
    "plugins",
    ".agents",
    ".claude-plugin",
    "claude-plugins",
    "scripts",
    "skills",
    "README.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "PRIVACY.md",
    "TERMS.md",
    "LICENSE.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "install-cep": "node dist/cli.js --install-cep",
    "doctor": "node dist/cli.js --doctor",
    "setup:mac": "bash ./scripts/install-macos.sh",
    "setup:doctor": "bash ./scripts/doctor-macos.sh",
    "setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows.ps1",
    "setup:doctor:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/doctor-windows.ps1",
    "uninstall:mac": "bash ./scripts/uninstall-macos.sh",
    "uninstall:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-windows.ps1",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "canary": "node scripts/api-canary.mjs",
    "uxp:install": "node scripts/install-uxp-probe.mjs",
    "release:installer": "node scripts/build-installer.mjs",
    "verify:report": "node scripts/build-verification-report.mjs",
    "coverage:tools": "node scripts/build-tool-coverage.mjs --aggregate",
    "coverage:tools:check": "node scripts/build-tool-coverage.mjs --check",
    "coverage:tools:measure": "PREMIERE_MCP_TOOL_COVERAGE=1 jest --runInBand && npm run coverage:tools",
    "verify:report:check": "node scripts/build-verification-report.mjs --check",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:report": "prettier --list-different \"src/**/*.ts\"",
    "prepack": "npm run build",
    "pack:check": "node scripts/verify-package.mjs",
    "bundle:mcpb": "node scripts/build-mcpb.mjs",
    "sign:zxp": "node scripts/sign-zxp.mjs",
    "create:self-signed-zxp-cert": "node scripts/create-self-signed-zxp-cert.mjs"
  },
  "keywords": [
    "premiere-mcp",
    "mcp",
    "model-context-protocol",
    "adobe-premiere-pro",
    "video-editing",
    "ai-automation",
    "extendscript",
    "uxp"
  ],
  "author": "Skry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrfilms/premiere-mcp.git"
  },
  "homepage": "https://github.com/skrfilms/premiere-mcp#readme",
  "bugs": {
    "url": "https://github.com/skrfilms/premiere-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "acorn": "^8.15.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
